{
  "buildCommand": "echo 'Static site'",
  "outputDirectory": ".",
  "public": true,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "routes": [
    {
      "src": "^/api/.*$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1"
    }
  ]
}
